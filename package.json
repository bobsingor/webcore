{
  "name": "webcore",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "pnpm --filter @webcore/wat-bin build && pnpm --filter @webcore/node-lib build",
    "dev": "pnpm build && pnpm --filter @webcore/playground dev",
    "test": "pnpm build && pnpm --filter @webcore/kernel test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^7.0.2"
  }
}
